# Arch Linux / CachyOS paketi. Kurulum: bu klasörde `makepkg -si`
pkgname=dubbitig
pkgver=1.8.0
pkgrel=1
pkgdesc="Komutlar, bağlantılar, notlar ve fotoğraflar için kişisel arşiv"
arch=('x86_64')
url="https://github.com/Nergal-exe/DubBitig"
license=('GPL-3.0-only')
depends=('gtk3' 'nss' 'alsa-lib' 'libnotify' 'libsecret' 'libxtst')
makedepends=('git' 'nodejs' 'npm')
optdepends=('libappindicator-gtk3: GNOME tepsi simgesi (AppIndicator eklentisiyle)')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')
# Electron ikilileri zaten soyulmuş; makepkg strip/debug Electron'u bozabilir.
options=('!strip' '!debug')

build() {
  cd "$pkgname"
  npm ci
  npm run build:integrations
  npm run build
  npx electron-builder --linux dir --publish never
}

package() {
  cd "$pkgname"
  install -d "$pkgdir/opt/$pkgname" "$pkgdir/usr/bin"
  cp -a release-dubbitig/linux-unpacked/. "$pkgdir/opt/$pkgname/"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"
  ln -s "/opt/$pkgname/dubbitig" "$pkgdir/usr/bin/dubbitig"
  install -Dm644 public/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/dubbitig.png"
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Dosya adı package.json desktopName ile aynı olmalı; Wayland pencere simgesi buna bağlı.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/dubbitig.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=DubBitig
Comment=$pkgdesc
Exec=dubbitig %U
Icon=dubbitig
Terminal=false
Categories=Office;Utility;
StartupWMClass=DubBitig
Actions=Hidden;

[Desktop Action Hidden]
Name=Tepside başlat
Exec=dubbitig --hidden
EOF
}

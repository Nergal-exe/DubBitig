{
  "manifest_version": 3,
  "name": "DubBitig’e kaydet",
  "version": "1.6.0",
  "description": "Seçili metinleri, komutları ve bağlantıları yerel DubBitig arşivine kaydet.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "notifications",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DubBitig’e kaydet"
  },
  "icons": {
    "128": "icon.png"
  }
}

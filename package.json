{
  "name": "dubbitig",
  "version": "1.11.0",
  "description": "Komutların, bağlantıların, notların ve fotoğrafların için kişisel arşiv.",
  "author": "DubBitig",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "node scripts/start.mjs",
    "test": "tsx --test tests/service.test.ts tests/data-location.test.ts tests/update.test.ts tests/design-dna.test.ts",
    "test:desktop": "node tests/desktop.mjs",
    "package": "npm run build:integrations && npm run build && electron-builder --win dir",
    "dist": "npm run build:integrations && npm run build && node scripts/build-setup.mjs",
    "build:integrations": "node scripts/build-integrations.mjs",
    "dist:portable": "npm run build:integrations && npm run build && electron-builder --win portable",
    "dist:linux": "npm run build:integrations && npm run build && electron-builder --linux AppImage deb pacman",
    "test:capture": "node tests/capture-desktop.mjs",
    "test:features": "node tests/features-15.mjs",
    "test:features18": "node tests/features-18.mjs",
    "test:data-location": "node tests/data-location-desktop.mjs",
    "test:styles": "node tests/design-styles.mjs",
    "test:tray-transfer": "node tests/tray-transfer.mjs",
    "screenshots": "node scripts/readme-screenshots.mjs"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "sql.js": "^1.14.2",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.sakli.archive",
    "productName": "DubBitig",
    "executableName": "DubBitig",
    "directories": {
      "output": "release-dubbitig"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/sql.js/dist/{sql-asm*,worker.*,*debug*,*browser*,*.zip}",
      "!node_modules/sql.js/{documentation,examples}/**",
      "!node_modules/**/*.{d.ts,d.cts,d.mts,map,md}",
      "!node_modules/zod/src/**"
    ],
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/qqwe.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "DubBitig-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DubBitig",
      "artifactName": "DubBitig-${version}-Setup.exe",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "chrome-extension",
        "to": "chrome-extension"
      },
      {
        "from": "firefox-extension",
        "to": "firefox-extension"
      },
      {
        "from": "build/native-host",
        "to": "native-host"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "public/icon.png",
      "category": "Office",
      "executableName": "dubbitig",
      "synopsis": "Komutlar, bağlantılar ve notlar için kişisel arşiv",
      "description": "Komutların, bağlantıların, notların ve fotoğrafların için kişisel arşiv.",
      "maintainer": "Nergal-exe <289826582+Nergal-exe@users.noreply.github.com>",
      "artifactName": "DubBitig-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "DubBitig"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "libsecret-1-0"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libnotify",
        "libsecret",
        "libxtst"
      ]
    }
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "homepage": "https://github.com/Nergal-exe/DubBitig",
  "desktopName": "dubbitig.desktop"
}

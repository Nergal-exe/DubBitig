import { contextBridge, ipcRenderer } from 'electron';
const names = ['deleteAllData', 'emptyTrash', 'cleanupAssets', 'checkUpdate', 'setBackupTime', 'setCloseAction', 'setOpenAtLogin', 'snapshot', 'save', 'trash', 'category', 'tag', 'history', 'restoreRevision', 'readNotice', 'setBackupPeriod', 'setLinkChecker', 'checkLinks', 'previewUrl', 'testNotification', 'image', 'addPhotos', 'copy', 'openUrl', 'exportArchive', 'importArchive', 'backup', 'backups', 'restoreBackup', 'settings', 'setAutoBackup', 'setTheme', 'openFolder', 'changeDataLocation', 'cleanupPreviousData'];
contextBridge.exposeInMainWorld('sakli', { ...Object.fromEntries([...names,'captureClipboard','integrationFolder','integrationWelcome'].map(name => [name, (...args: unknown[]) => ipcRenderer.invoke(`sakli:${name}`, ...args)])), onCaptured: (callback: (value:{id:string;title:string})=>void) => { const listener=(_event:unknown,value:{id:string;title:string})=>callback(value);ipcRenderer.on('sakli:captured',listener);return ()=>ipcRenderer.removeListener('sakli:captured',listener); }, onRelocationProgress: (callback: (value:unknown)=>void) => { const listener=(_event:unknown,value:unknown)=>callback(value);ipcRenderer.on('sakli:relocation',listener);return ()=>ipcRenderer.removeListener('sakli:relocation',listener); } });
